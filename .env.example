# ── Public (exposed to the browser) ───────────────────────────────────────────
# Canonical site URL used for metadata, sitemap and Open Graph. Falls back to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=https://growxera.com
# Booking link for "Book a Growth Diagnostic" (Calendly, Cal.com, HubSpot…). Empty = falls back to /contact.
NEXT_PUBLIC_BOOKING_URL=
# Shown in the footer and privacy notice. Empty = hidden / marked as to-be-completed.
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format without "+" (e.g. 9665XXXXXXXX). Empty = hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Server only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# Supabase project URL and service-role key. Without them: dev writes to .data/*.jsonl, production stores nothing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: POST a lead summary here on every new lead (Slack incoming webhook, Make, Zapier, CRM).
LEAD_WEBHOOK_URL=

# Google Analytics 4 measurement ID (G-XXXXXXX). Loads only after the visitor accepts analytics.
NEXT_PUBLIC_GA4_ID=

# Email the diagnostic report to the lead (https://resend.com). Server-only.
RESEND_API_KEY=
# Verified sender, e.g. "Growx Era <hello@growxera.com>"
REPORT_FROM_EMAIL=
